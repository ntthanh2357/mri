# ==============================================================================
# NeuroScan AI - Mẫu Biến Môi Trường (Environment Variables Template)
# Hướng dẫn: Sao chép tệp này thành .env trong thư mục BE/ và cấu hình giá trị thực tế
# ==============================================================================

# Cổng máy chủ Backend
PORT=5000
NODE_ENV=development

# Chuỗi kết nối MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/neuroscan

# Mã bí mật JWT Token
JWT_SECRET=neuroscan_jwt_secret_dev_key_change_in_production
JWT_REFRESH_SECRET=neuroscan_jwt_refresh_secret_dev_key_change_in_production
JWT_EXPIRES_IN=24h

# Địa chỉ Dịch vụ Python FastAPI AI Engine
AI_SERVER_URL=http://127.0.0.1:8000/predict

# Cổng thanh toán PayOS / VietQR (Đăng ký tại payos.vn)
PAYOS_CLIENT_ID=your_payos_client_id_here
PAYOS_API_KEY=your_payos_api_key_here
PAYOS_CHECKSUM_KEY=your_payos_checksum_key_here

# Cấu hình Email gửi thông báo (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM="Hệ Thống Y Tế NeuroScan AI" <noreply@neuroscan.vn>

# Cấu hình lưu trữ đám mây Google Cloud Storage (Tùy chọn)
GCS_BUCKET_NAME=neuroscan-mri-storage
GCS_PROJECT_ID=neuroscan-project-id
GOOGLE_APPLICATION_CREDENTIALS=./config/gcs-key.json
