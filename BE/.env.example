NODE_ENV=development
PORT=5000
ALLOWED_ORIGINS=http://localhost:8083,http://localhost:19006

MONGO_URI=
TEST_MONGO_URI=

JWT_SECRET=
JWT_REFRESH_SECRET=

FRONTEND_URL=

AI_SERVER_URL=http://localhost:8000
AI_FEEDBACK_PATH=
AI_MODEL_VERSIONS=
AI_RETRAIN_THRESHOLD=
CHATBOT_CONFIG_PATH=

EMAIL_USER=
EMAIL_PASS=
PHONE_SALT=

FIREBASE_API_KEY=
FIREBASE_STORAGE_BUCKET=
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_PATH=

GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=
STORAGE_MODE=

GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_PARENT_FOLDER_ID=

PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# ── Auth cache ──
AUTH_CACHE_ENABLED=true
AUTH_CACHE_TTL_MS=60000
ENABLE_DEBUG_OTP=false

# ── Compliance & Security feature flags (mặc định BẬT trừ khi set "false") ──
# xem BE/src/config/features.config.js
ENABLE_JWT_ALGORITHM_LOCK=true
ENABLE_EMR_IMMUTABLE_LOCK=true
ENABLE_HASH_CHAIN_AUDIT=true
ENABLE_DATA_SEGREGATION=true
ENABLE_FIELD_LEVEL_ENCRYPTION=true
ENABLE_RETENTION_ENGINE=true
ENABLE_RATE_LIMIT=true
FIELD_ENCRYPTION_KEY=

# ── Security alerting (tùy chọn) ──
SECURITY_SIEM_WEBHOOK_URL=
SLACK_SECURITY_WEBHOOK_URL=
