# Có thể dùng 1 trong 2 cách:
# - GEMINI_API_KEYS: nhiều key cách nhau bằng dấu phẩy, gemini_rotator.py tự xoay vòng khi bị rate limit (khuyến nghị)
# - GEMINI_API_KEY: 1 key duy nhất (fallback nếu không set GEMINI_API_KEYS)
GEMINI_API_KEYS=your_api_key_1,your_api_key_2
GEMINI_API_KEY=your_api_key_here

# Tùy chọn — có giá trị mặc định trong code nếu không set
GEMINI_MODEL=gemini-3.1-flash-lite
AUDIT_DB_PATH=audit_logs.db